{
  "name": "vellora",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:preview": "vite build --mode singlefile && node scripts/rename-preview.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "fixtures": "node scripts/make-fixtures.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.8.1",
